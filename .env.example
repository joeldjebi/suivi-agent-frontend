# URL des tuiles de la carte (MapTiler, Stadia Maps…). Vide = tuiles OSM publiques (dev uniquement).
VITE_TILE_URL=

# Serveur temps réel (Socket.IO). Vide = l'API sur le port 3000 en développement, le même domaine en production.
VITE_SOCKET_URL=

# Adresse secrète de la console éditeur (super administrateur), ex. /console-7k2m9x4q.
# Vide = console désactivée sur ce déploiement (aucune page, aucun lien).
VITE_PLATFORM_PATH=
